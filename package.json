{
  "name": "async-iterator-watchdog",
  "version": "1.0.1",
  "description": "Enforce first-progress, idle, and total deadlines on AsyncIterables with heartbeat-aware liveness and abort cleanup.",
  "keywords": [
    "async-iterator",
    "async-iterable",
    "timeout",
    "idle-timeout",
    "streaming",
    "abort-signal",
    "ai"
  ],
  "license": "MIT",
  "author": "Huzaifa Asif",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huzaifa-Asif/async-iterator-watchdog.git"
  },
  "bugs": {
    "url": "https://github.com/Huzaifa-Asif/async-iterator-watchdog/issues"
  },
  "homepage": "https://github.com/Huzaifa-Asif/async-iterator-watchdog#readme",
  "type": "module",
  "main": "./src/index.cjs",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./src/index.cjs"
    }
  },
  "files": [
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test",
    "check": "npm run build && npm run lint && npm run test:coverage && node examples/heartbeat-aware.mjs && npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  }
}
